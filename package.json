{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@bojackduy/opencode-loopd",
  "version": "1.10.1",
  "description": "Codex-inspired background goal engine for OpenCode — autonomous subagents, engine-driven loop, child worker sessions and modal TUI dashboard. Like Claude Code loop for OpenCode.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bojackduy/opencode-loopd.git"
  },
  "homepage": "https://bojackduy.github.io/opencode-loopd/",
  "bugs": {
    "url": "https://github.com/bojackduy/opencode-loopd/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "loop",
    "goal",
    "background",
    "background-agent",
    "automation",
    "autonomous",
    "agent",
    "subagent",
    "codex",
    "claude-code",
    "opencode-loopd"
  ],
  "bin": {
    "opencode-loopd": "./scripts/install-node.mjs"
  },
  "files": [
    "dist",
    "scripts",
    "skills",
    "commands",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "exports": {
    ".": {
      "import": "./dist/server.js"
    },
    "./server": {
      "import": "./dist/server.js"
    },
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:server": "bun build src/server/plugin.ts --outfile dist/server.js --target bun --external @opencode-ai/plugin --external @opencode-ai/plugin/tool --external @opencode-ai/plugin/v2/promise",
    "build:tui": "bun scripts/build-tui.ts",
    "build": "bun run build:server && bun run build:tui",
    "clean": "rm -rf dist",
    "prepack": "bun run typecheck && bun test && bun run build",
    "test": "bun test",
    "release:patch": "bun run typecheck && bun test && npm version patch -m \"chore: release %s\" && git push && git push origin $(git describe --tags --abbrev=0)",
    "release:minor": "bun run typecheck && bun test && npm version minor -m \"chore: release %s\" && git push && git push origin $(git describe --tags --abbrev=0)",
    "release:major": "bun run typecheck && bun test && npm version major -m \"chore: release %s\" && git push && git push origin $(git describe --tags --abbrev=0)"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.4.0 <3",
    "@opentui/core": "*",
    "@opentui/solid": "*",
    "solid-js": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.30",
    "@opencode/plugin": "^2.0.11",
    "@opentui/core": "^0.4.1",
    "@opentui/solid": "^0.4.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "solid-js": "^1.9.13",
    "typescript": "^5.7.0"
  }
}
