{
  "name": "opencode-loopd",
  "version": "0.1.0",
  "description": "Codex-inspired goal engine for OpenCode with modal TUI dashboard.",
  "type": "module",
  "exports": {
    "./server": "./dist/server.js",
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:server": "bun build src/server/plugin.ts --outfile dist/server.js --target bun --external @opencode-ai/plugin --external @opencode-ai/plugin/tool",
    "build:tui": "bun scripts/build-tui.ts",
    "build": "bun run build:server && bun run build:tui",
    "clean": "rm -rf dist",
    "prepack": "npm run typecheck && npm test && npm run build",
    "test": "bun test"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.4.0 <2"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.15",
    "@opentui/core": "latest",
    "@opentui/solid": "latest",
    "@types/node": "^26.2.0",
    "solid-js": "^1.9.13",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist"
  ],
  "license": "MIT"
}
