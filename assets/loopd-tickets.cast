[0.007, "o", "\r\n### loopd ticket-per-scope: live demo (real plugin, real store)\r\n"]
[1.008, "o", "$ opencode plugin list 2>/dev/null | grep -i loopd\r\n"]
[0.658, "o", "opencode-loopd.server           1.14.6         file:/Users/duytrinh/Code/opencode-loopd\r\n"]
[1.010, "o", "\r\n### parallel disjoint writes + overlap queue + crash sweep\r\n"]
[1.004, "o", "$ bun run /tmp/loopd-ticket-demo.mjs\r\n"]
[0.625, "o", "1) two workers, disjoint files -> both granted in parallel\r\n"]
[0.027, "o", "   w1 src/a.ts: fulfilled | w2 src/b.ts: fulfilled\r\n2) third write overlaps src/a.ts -> queued, not blocked globally\r\n"]
[0.001, "o", "   w1 src/a.ts again: queued: Write ticket queued for src/a.ts\r\n3) release p1 -> queued p3 is promoted to holder\r\n"]
[0.002, "o", "   holders now: p2, p3\r\n"]
[0.001, "o", "4) crash shape: goal deleted, holder orphaned -> periodic sweep reaps it\r\n"]
[0.002, "o", "   sweep reaped: [\"dead\"] | holders: \u001b[0m\u001b[33m0\u001b[0m\r\n"]
[0.000, "o", "DONE: no global lock, no stuck ticket\r\n"]
[1.009, "o", "\r\n### trace: every grant/queue hits the flow log\r\n"]
[1.006, "o", "$ grep -o '\"event\":\"ticket\\.[a-z.]*\"' /tmp/loopd-server.log | sort | uniq -c | tail -5\r\n"]
